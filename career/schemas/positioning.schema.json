{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careeros.dev/schemas/positioning.schema.json",
  "$defs": {
    "Emphasis": {
      "additionalProperties": false,
      "properties": {
        "skills": {
          "items": {
            "description": "stable identifier, never renamed",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,79}$",
            "type": "string"
          },
          "title": "Skills",
          "type": "array"
        },
        "achievements": {
          "items": {
            "description": "stable identifier, never renamed",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,79}$",
            "type": "string"
          },
          "title": "Achievements",
          "type": "array"
        },
        "projects": {
          "items": {
            "description": "stable identifier, never renamed",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,79}$",
            "type": "string"
          },
          "title": "Projects",
          "type": "array"
        },
        "offers": {
          "items": {
            "description": "stable identifier, never renamed",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,79}$",
            "type": "string"
          },
          "title": "Offers",
          "type": "array"
        }
      },
      "title": "Emphasis",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/EvidenceType"
        },
        "ref": {
          "description": "item id (project/testimonial/certification/publication) or URL",
          "title": "Ref",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "type",
        "ref"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceType": {
      "enum": [
        "project",
        "link",
        "testimonial",
        "certification",
        "publication",
        "file"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "ItemStatus": {
      "enum": [
        "draft",
        "verified",
        "retired"
      ],
      "title": "ItemStatus",
      "type": "string"
    },
    "TargetMarket": {
      "enum": [
        "remote_us",
        "remote_eu",
        "eu_b2b",
        "freelance",
        "poland",
        "startup",
        "enterprise",
        "consulting"
      ],
      "title": "TargetMarket",
      "type": "string"
    },
    "Visibility": {
      "additionalProperties": false,
      "properties": {
        "linkedin": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "const": "optional",
              "type": "string"
            }
          ],
          "default": true,
          "title": "Linkedin"
        },
        "wellfound": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "const": "optional",
              "type": "string"
            }
          ],
          "default": true,
          "title": "Wellfound"
        },
        "upwork": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "const": "optional",
              "type": "string"
            }
          ],
          "default": true,
          "title": "Upwork"
        },
        "toptal": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "const": "optional",
              "type": "string"
            }
          ],
          "default": true,
          "title": "Toptal"
        },
        "ats": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "const": "optional",
              "type": "string"
            }
          ],
          "default": true,
          "title": "Ats"
        },
        "direct_outreach": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "const": "optional",
              "type": "string"
            }
          ],
          "default": true,
          "title": "Direct Outreach"
        }
      },
      "title": "Visibility",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "stable identifier, never renamed",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,79}$",
      "title": "Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ItemStatus",
      "default": "draft"
    },
    "visibility": {
      "$ref": "#/$defs/Visibility"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated At"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "private notes, never projected",
      "title": "Notes"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "headline": {
      "title": "Headline",
      "type": "string"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "target_markets": {
      "items": {
        "$ref": "#/$defs/TargetMarket"
      },
      "title": "Target Markets",
      "type": "array"
    },
    "emphasize": {
      "$ref": "#/$defs/Emphasis"
    },
    "deemphasize": {
      "items": {
        "description": "stable identifier, never renamed",
        "pattern": "^[a-z0-9][a-z0-9_-]{1,79}$",
        "type": "string"
      },
      "title": "Deemphasize",
      "type": "array"
    },
    "keywords_must": {
      "items": {
        "type": "string"
      },
      "title": "Keywords Must",
      "type": "array"
    },
    "keywords_nice": {
      "items": {
        "type": "string"
      },
      "title": "Keywords Nice",
      "type": "array"
    },
    "tone": {
      "default": "concise, factual, senior",
      "title": "Tone",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "headline",
    "summary",
    "target_markets"
  ],
  "title": "Positioning",
  "type": "object"
}
