# CareerOS — secrets template. Copy to config/.env.secrets (git-ignored) and fill in.
# Blank values and ${VAR:-} expressions only — a non-empty literal here is a leak.

# Optional bearer token protecting the API (leave blank for open local single-user mode)
CAREEROS_API_TOKEN=${CAREEROS_API_TOKEN:-}

# AI providers — set whichever you use
CAREEROS_ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY:-}
CAREEROS_OPENAI_API_KEY=${OPENAI_API_KEY:-}

# compose-level
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-}

# Telegram bot (@careeros_hnkovr_bot) — docs/developer-guide/telegram-bot.md
# Mint/repair the token with: just bot-token-ensure  (verifies via getMe)
CAREEROS_TG_BOT_TOKEN=${CAREEROS_TG_BOT_TOKEN:-}
# Echoed by Telegram in X-Telegram-Bot-Api-Secret-Token; unsigned request -> 403.
# Generate with: openssl rand -hex 32
CAREEROS_TG_WEBHOOK_SECRET=${CAREEROS_TG_WEBHOOK_SECRET:-}
# The only chat the bot serves; any other chat gets 200 and no side effect.
CAREEROS_TG_OWNER_CHAT_ID=${CAREEROS_TG_OWNER_CHAT_ID:-}

# Private career vault remote. Carries a token, so it is a secret, not config.
# Unset -> the deployed app falls back to the bundled demo vault.
CAREEROS_VAULT_GIT_URL=${CAREEROS_VAULT_GIT_URL:-}

# platform connectors (ADR-013): OAuth apps — hh.ru: https://dev.hh.ru · Upwork: https://www.upwork.com/developer
# tokens are normally kept in CAREEROS_PLATFORM_TOKEN_FILE; set them here only to pin them (containers)
CAREEROS_HH_CLIENT_ID=${CAREEROS_HH_CLIENT_ID:-}
CAREEROS_HH_CLIENT_SECRET=${CAREEROS_HH_CLIENT_SECRET:-}
CAREEROS_HH_ACCESS_TOKEN=${CAREEROS_HH_ACCESS_TOKEN:-}
CAREEROS_HH_REFRESH_TOKEN=${CAREEROS_HH_REFRESH_TOKEN:-}
CAREEROS_UPWORK_CLIENT_ID=${CAREEROS_UPWORK_CLIENT_ID:-}
CAREEROS_UPWORK_CLIENT_SECRET=${CAREEROS_UPWORK_CLIENT_SECRET:-}
CAREEROS_UPWORK_ACCESS_TOKEN=${CAREEROS_UPWORK_ACCESS_TOKEN:-}
CAREEROS_UPWORK_REFRESH_TOKEN=${CAREEROS_UPWORK_REFRESH_TOKEN:-}

# Jina Reader (ADR-015 job-read fallback): optional — anonymous reads work, a key raises the rate limit.
# https://jina.ai/reader
CAREEROS_JINA_API_KEY=${CAREEROS_JINA_API_KEY:-}
