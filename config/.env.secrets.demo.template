# CareerOS — secrets template. Copy to config/.env.secrets (git-ignored) and fill in.
# Blank values and ${VAR:-} expressions only — a non-empty literal here is a leak.

# Optional bearer token protecting the API (leave blank for open local single-user mode)
CAREEROS_API_TOKEN=${CAREEROS_API_TOKEN:-}

# AI providers — set whichever you use
CAREEROS_ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY:-}
CAREEROS_OPENAI_API_KEY=${OPENAI_API_KEY:-}

# compose-level
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-}
