# CareerOS — non-secret configuration. Rendered to ./.env by `make env` (scripts/env-render.py).
# Every variable is read by services/careeros/src/careeros/core/config.py (prefix CAREEROS_).
# Use ${VAR:-default} forms; never put real secrets here (see .env.secrets.demo.template).

CAREEROS_ENV=${CAREEROS_ENV:-dev}
CAREEROS_LOG_LEVEL=${CAREEROS_LOG_LEVEL:-INFO}
CAREEROS_LOG_JSON=${CAREEROS_LOG_JSON:-false}
CAREEROS_API_PORT=${CAREEROS_API_PORT:-8000}
CAREEROS_CORS_ORIGINS='${CAREEROS_CORS_ORIGINS:-["http://localhost:3000"]}'

# storage (local dev against `docker compose up postgres redis`)
CAREEROS_DATABASE_URL=${CAREEROS_DATABASE_URL:-postgresql+asyncpg://careeros:careeros@localhost:5432/careeros}
CAREEROS_TEST_DATABASE_URL=${CAREEROS_TEST_DATABASE_URL:-postgresql+asyncpg://careeros:careeros@localhost:5432/careeros_test}
CAREEROS_REDIS_URL=${CAREEROS_REDIS_URL:-redis://localhost:6379/0}
CAREEROS_GENERATED_DIR=${CAREEROS_GENERATED_DIR:-generated}

# vault — point at your private career repo; default is the git-ignored career/private
CAREEROS_VAULT_PATH=${CAREEROS_VAULT_PATH:-career/private}
CAREEROS_VAULT_GIT_USER_NAME=${CAREEROS_VAULT_GIT_USER_NAME:-CareerOS}
CAREEROS_VAULT_GIT_USER_EMAIL=${CAREEROS_VAULT_GIT_USER_EMAIL:-careeros@localhost}
CAREEROS_VAULT_AUTO_PUSH=${CAREEROS_VAULT_AUTO_PUSH:-false}

# single user (P0)
CAREEROS_USER_EMAIL=${CAREEROS_USER_EMAIL:-demo@careeros.local}

# AI defaults (keys live in .env.secrets)
CAREEROS_AI_DEFAULT_PROVIDER=${CAREEROS_AI_DEFAULT_PROVIDER:-anthropic}
CAREEROS_AI_FALLBACK_PROVIDERS=${CAREEROS_AI_FALLBACK_PROVIDERS:-[]}
CAREEROS_ANTHROPIC_MODEL=${CAREEROS_ANTHROPIC_MODEL:-claude-sonnet-5}
CAREEROS_OPENAI_BASE_URL=${CAREEROS_OPENAI_BASE_URL:-https://api.openai.com/v1}
CAREEROS_OPENAI_MODEL=${CAREEROS_OPENAI_MODEL:-gpt-5}
CAREEROS_AI_STRUCTURED_MAX_RETRIES=${CAREEROS_AI_STRUCTURED_MAX_RETRIES:-2}
CAREEROS_AI_STORE_INPUTS=${CAREEROS_AI_STORE_INPUTS:-true}
CAREEROS_AI_INPUTS_RETENTION_DAYS=${CAREEROS_AI_INPUTS_RETENTION_DAYS:-90}

# tasks: inline (no redis, synchronous) | arq
CAREEROS_TASK_RUNNER=${CAREEROS_TASK_RUNNER:-arq}

# telegram bot — non-secret settings (secrets live in .env.secrets)
CAREEROS_TG_ENABLED=${CAREEROS_TG_ENABLED:-false}
CAREEROS_TG_WEBHOOK_PATH=${CAREEROS_TG_WEBHOOK_PATH:-/tg/webhook}
# Eligibility key: unset -> this process never talks to Telegram, so a local run
# can never steal the deployed bot's updates.
CAREEROS_TG_PUBLIC_URL=${CAREEROS_TG_PUBLIC_URL:-}
CAREEROS_TG_NOTIFY_MIN_SCORE=${CAREEROS_TG_NOTIFY_MIN_SCORE:-75}

# platform connectors (ADR-013): token file (git-ignored, mode 0600), OAuth redirect base, HTTP client
CAREEROS_PLATFORM_TOKEN_FILE=${CAREEROS_PLATFORM_TOKEN_FILE:-generated/platform/tokens.json}
CAREEROS_PLATFORM_OAUTH_REDIRECT_BASE=${CAREEROS_PLATFORM_OAUTH_REDIRECT_BASE:-http://localhost:8000/api/platform/oauth}
CAREEROS_PLATFORM_HTTP_TIMEOUT_S=${CAREEROS_PLATFORM_HTTP_TIMEOUT_S:-20}
CAREEROS_PLATFORM_USER_AGENT='${CAREEROS_PLATFORM_USER_AGENT:-CareerOS/0.1 (careeros@localhost)}'

# --- job reads (ADR-015): one public read per user-supplied URL, bounded, cached, robots-aware.
# Non-secret knobs only; the Jina key lives in .env.secrets. Blank = the code default applies
# only for optional vars — the others use the ${VAR:-default} form like the rest of this file.
CAREEROS_JOB_FETCH_HTTP_TIMEOUT_S=${CAREEROS_JOB_FETCH_HTTP_TIMEOUT_S:-20}
CAREEROS_JOB_FETCH_MAX_ATTEMPTS=${CAREEROS_JOB_FETCH_MAX_ATTEMPTS:-4}
CAREEROS_JOB_FETCH_MAX_TOTAL_S=${CAREEROS_JOB_FETCH_MAX_TOTAL_S:-30}
CAREEROS_JOB_FETCH_MAX_ARCHIVE_CALLS=${CAREEROS_JOB_FETCH_MAX_ARCHIVE_CALLS:-2}
CAREEROS_JOB_FETCH_MAX_SEARCH_CALLS=${CAREEROS_JOB_FETCH_MAX_SEARCH_CALLS:-0}
CAREEROS_JOB_FETCH_ENABLE_PUBLIC_HTML=${CAREEROS_JOB_FETCH_ENABLE_PUBLIC_HTML:-true}
# Jina Reader / Wayback hand the (public) URL to a third party; never used for URLs from private messages.
CAREEROS_JOB_FETCH_ENABLE_JINA=${CAREEROS_JOB_FETCH_ENABLE_JINA:-true}
CAREEROS_JOB_FETCH_ENABLE_WAYBACK=${CAREEROS_JOB_FETCH_ENABLE_WAYBACK:-true}
CAREEROS_JOB_FETCH_CACHE_TTL_S=${CAREEROS_JOB_FETCH_CACHE_TTL_S:-3600}
CAREEROS_JOB_FETCH_NEGATIVE_CACHE_TTL_S=${CAREEROS_JOB_FETCH_NEGATIVE_CACHE_TTL_S:-300}
# unset -> raw artifacts are kept indefinitely
CAREEROS_JOB_FETCH_RAW_RETENTION_DAYS=${CAREEROS_JOB_FETCH_RAW_RETENTION_DAYS:-}
CAREEROS_JINA_READER_BASE=${CAREEROS_JINA_READER_BASE:-https://r.jina.ai}
CAREEROS_WAYBACK_CDX_BASE=${CAREEROS_WAYBACK_CDX_BASE:-https://web.archive.org}
# per-provider kill switches
CAREEROS_ROCKETHUNT_ENABLE_PUBLIC_HTML=${CAREEROS_ROCKETHUNT_ENABLE_PUBLIC_HTML:-true}
CAREEROS_JUSTJOIN_ENABLE_PUBLIC_API=${CAREEROS_JUSTJOIN_ENABLE_PUBLIC_API:-true}
# scheduled refresh of stored opportunities (phase H) — opt-in
CAREEROS_JOB_REFRESH_ENABLED=${CAREEROS_JOB_REFRESH_ENABLED:-false}
CAREEROS_JOB_REFRESH_INTERVAL_H=${CAREEROS_JOB_REFRESH_INTERVAL_H:-24}
CAREEROS_JOB_REFRESH_MAX_PER_RUN=${CAREEROS_JOB_REFRESH_MAX_PER_RUN:-20}
# `pytest -m live` touches real sites; off by default
CAREEROS_LIVE_TESTS=${CAREEROS_LIVE_TESTS:-false}
